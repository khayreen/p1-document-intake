# Copy this file to .env and fill in your key. .env is ignored by Git.

# rules = no model, no key needed.  llm = use the model below.
INTAKE_EXTRACTOR=llm

# openai = any OpenAI-compatible API (Groq here).  bedrock-converse = Amazon Bedrock.
SPRING_AI_MODEL_CHAT=openai

GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Only for SPRING_AI_MODEL_CHAT=bedrock-converse (uses your AWS CLI credentials)
AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
